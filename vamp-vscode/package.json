{
  "name": "vamp-lang",
  "publisher": "Clxtus",
  "displayName": "Vamp Language Support",
  "description": "Syntax highlighting, error checking, completion, formatting, running and debugging for the Vamp programming language.",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clxtus/Vamp"
  },
  "bugs": {
    "url": "https://github.com/Clxtus/Vamp/issues"
  },
  "homepage": "https://github.com/Clxtus/Vamp#readme",
  "keywords": [
    "vamp",
    "vp",
    "vpdata",
    "language",
    "compiler"
  ],
  "galleryBanner": {
    "color": "#1a0000",
    "theme": "dark"
  },
  "version": "1.3.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vamp",
    "onLanguage:vampdata",
    "onDebugResolve:vamp",
    "onDebugDynamicConfigurations:vamp",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vamp",
        "aliases": [
          "Vamp",
          "vamp"
        ],
        "extensions": [
          ".vp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Vamp.svg",
          "dark": "./icons/Vamp.svg"
        }
      },
      {
        "id": "vampdata",
        "aliases": [
          "Vamp Data",
          "vpdata"
        ],
        "extensions": [
          ".vpdata"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Data.svg",
          "dark": "./icons/Data.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "vamp",
        "scopeName": "source.vamp",
        "path": "./syntaxes/vp.tmLanguage.json"
      },
      {
        "language": "vampdata",
        "scopeName": "source.vampdata",
        "path": "./syntaxes/vpdata.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "vamp"
      }
    ],
    "commands": [
      {
        "command": "vamp.run",
        "title": "Vamp: Run File",
        "icon": "$(play)"
      },
      {
        "command": "vamp.test",
        "title": "Vamp: Run Tests in File"
      },
      {
        "command": "vamp.buildDebug",
        "title": "Vamp: Build for Debugging"
      }
    ],
    "configuration": {
      "title": "Vamp",
      "properties": {
        "vamp.compiler": {
          "type": "string",
          "default": "",
          "description": "Command that runs the Vamp compiler, for example \"vamp\" or \"python C:/path/Compiler/main.py\". Empty: Compiler/main.py in the workspace, then the installed vamp.exe, then vamp on the PATH."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "vamp.run",
          "when": "resourceLangId == vamp",
          "group": "navigation@1"
        }
      ]
    },
    "debuggers": [
      {
        "type": "vamp",
        "label": "Vamp",
        "languages": [
          "vamp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .vp file to build and run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command line arguments for the program.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "vamp",
            "request": "launch",
            "name": "Run Vamp File",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Vamp: Run File",
            "description": "Build and run the current .vp file",
            "body": {
              "type": "vamp",
              "request": "launch",
              "name": "Run Vamp File",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  }
}
