{
  "name": "vamp-lang",
  "publisher": "Clxtus",
  "displayName": "Vamp Language Support",
  "description": "Language support for the Vamp programming language.",
  "version": "1.0.5",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vamp",
        "aliases": ["Vamp", "vamp"],
        "extensions": [".vp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Vamp.svg",
          "dark": "./icons/Vamp.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "vamp",
        "scopeName": "source.vamp",
        "path": "./syntaxes/vp.tmLanguage.json"
      }
    ]
  }
}
