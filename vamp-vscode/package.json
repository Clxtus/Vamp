{
  "name": "vamp-lang",
  "displayName": "Vamp Language",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onLanguage:vamp"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vamp",
        "aliases": ["Vamp", "vamp"],
        "extensions": [".vp"]
      }
    ],
    "grammars": [
      {
        "language": "vamp",
        "scopeName": "source.vp",
        "path": "./syntaxes/vp.tmLanguage.json"
      }
    ]
  }
}