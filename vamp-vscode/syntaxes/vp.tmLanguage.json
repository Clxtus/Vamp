{
  "name": "Vamp",
  "scopeName": "source.vp",
  "patterns": [
    {
      "name": "keyword.control.vp",
      "match": "\\b(val|const)\\b"
    },
    {
      "name": "storage.type.vp",
      "match": "\\b(int|float|bool|string)\\b"
    },
    {
      "name": "constant.language.boolean.vp",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "entity.name.function.vp",
      "match": "\\b(println|print|exit|free)\\b"
    },
    {
      "name": "string.quoted.double.vp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vp",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.vp",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ]
}