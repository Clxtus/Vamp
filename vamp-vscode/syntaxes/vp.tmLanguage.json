{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vamp",
  "scopeName": "source.vamp",
  "patterns": [
    { "include": "#block-comments" },
    { "include": "#line-comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#imports" },
    { "include": "#function-declarations" },
    { "include": "#type-declarations" },
    { "include": "#catch-variable" },
    { "include": "#for-loop" },
    { "include": "#variable-declarations" },
    { "include": "#library-function-calls" },
    { "include": "#library-names" },
    { "include": "#method-calls" },
    { "include": "#window-properties" },
    { "include": "#dictionary-properties" },
    { "include": "#built-in-functions" },
    { "include": "#self" },
    { "include": "#keywords" },
    { "include": "#casts" },
    { "include": "#types" },
    { "include": "#type-names" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-parameters" },
    { "include": "#variables" }
  ],
  "repository": {
    "imports": {
      "patterns": [
        {
          "name": "meta.import.vamp",
          "match": "\\b(import)\\s+(?!\")([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.namespace.vamp" }
          }
        },
        {
          "name": "meta.import.vamp",
          "match": "\\b(from)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.namespace.vamp" }
          }
        },
        {
          "name": "meta.import.vamp",
          "match": "\\b(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.namespace.vamp" }
          }
        },
        {
          "name": "keyword.control.vamp",
          "match": "\\blink(?=\\s*\")"
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "name": "meta.class.declaration.vamp",
          "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(\\()\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\)))?",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.type.class.vamp" },
            "3": { "name": "punctuation.section.group.vamp" },
            "4": { "name": "entity.name.type.class.vamp" },
            "5": { "name": "punctuation.section.group.vamp" }
          }
        },
        {
          "name": "meta.type.declaration.vamp",
          "match": "\\b(struct|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.type.class.vamp" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "name": "meta.function.vamp",
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "entity.name.function.vamp" }
          }
        }
      ]
    },
    "catch-variable": {
      "patterns": [
        {
          "name": "meta.catch.vamp",
          "match": "\\b(catch)\\s*(\\()\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "punctuation.section.group.vamp" },
            "3": { "name": "variable.parameter.vamp" },
            "4": { "name": "punctuation.section.group.vamp" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.vamp",
          "match": "\\b(?!(?:import|from|as|link|val|const|func|return|if|else|for|in|while|class|struct|enum|match|break|continue|try|catch|throw|and|or|not)\\b)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.vamp" }
          }
        }
      ]
    },
    "variable-declarations": {
      "patterns": [
        {
          "name": "meta.variable.declaration.vamp",
          "match": "\\b(val|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)((?:\\s*,\\s*[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "variable.other.vamp" },
            "3": {
              "patterns": [
                { "name": "punctuation.separator.vamp", "match": "," },
                { "name": "variable.other.vamp", "match": "[a-zA-Z_][a-zA-Z0-9_]*" }
              ]
            }
          }
        }
      ]
    },
    "for-loop": {
      "patterns": [
        {
          "name": "meta.for-loop.vamp",
          "match": "\\b(for)(\\s*\\()([a-zA-Z_][a-zA-Z0-9_]*)(\\s*\\))(\\s+)(in)(\\s*\\()",
          "captures": {
            "1": { "name": "keyword.control.vamp" },
            "2": { "name": "punctuation.section.group.vamp" },
            "3": { "name": "variable.other.vamp" },
            "4": { "name": "punctuation.section.group.vamp" },
            "6": { "name": "keyword.control.vamp" },
            "7": { "name": "punctuation.section.group.vamp" }
          }
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.vamp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:\\s*(?:int|float|bool|str|double|f32|char|i8|i16|i32|i64|u8|u16|u32|u64|list|map|json|[A-Z][a-zA-Z0-9_]*)\\b)"
        }
      ]
    },
    "library-function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.vamp",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\s*\\.\\s*)([A-Z][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.vamp" },
            "2": { "name": "punctuation.accessor.vamp" },
            "3": { "name": "support.function.builtin.vamp" }
          }
        }
      ]
    },
    "library-names": {
      "patterns": [
        {
          "name": "entity.name.namespace.vamp",
          "match": "\\b(os|math|random|time|file|console|json|thread|net|input|audio)(?=\\s*\\.)"
        }
      ]
    },
    "method-calls": {
      "patterns": [
        {
          "name": "meta.method-call.vamp",
          "match": "(\\.)\\s*([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.vamp" },
            "2": { "name": "entity.name.function.vamp" }
          }
        }
      ]
    },
    "dictionary-properties": {
      "patterns": [
        {
          "name": "meta.dictionary-property.vamp",
          "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vamp" },
            "2": { "name": "variable.other.property.vamp" }
          }
        }
      ]
    },
    "window-properties": {
      "patterns": [
        {
          "name": "meta.window-property.vamp",
          "match": "\\b(icon|size|resizable|type|style|theme|position|visible|layer|group|text|text_color|text_transparency|text_size|font|background_color|background_transparency|editable|corner_radius)(?=\\s*=(?!=))",
          "captures": {
            "1": { "name": "variable.other.property.vamp" }
          }
        }
      ]
    },
    "built-in-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vamp",
          "match": "\\b(exit|free|malloc|print|println|len|range)(?=\\s*\\()"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.vamp",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vamp",
          "match": "\\b(import|from|as|val|const|func|return|if|else|for|in|while|class|struct|enum|match|break|continue|try|catch|throw)\\b"
        },
        {
          "name": "keyword.operator.logical.vamp",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.vamp",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "casts": {
      "patterns": [
        {
          "name": "storage.type.vamp",
          "match": "\\b(int|float|bool|str|double|f32|char|i8|i16|i32|i64|u8|u16|u32|u64)(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.vamp",
          "match": "\\b(int|float|bool|str|double|f32|char|i8|i16|i32|i64|u8|u16|u32|u64|void|list|map|json)\\b"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.class.vamp",
          "match": "\\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]*)*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vamp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vamp",
          "match": "\\\\[nt\"\\\\]"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.vamp",
          "match": "'(\\\\[ntr0\\\\'])'",
          "captures": {
            "1": { "name": "constant.character.escape.vamp" }
          }
        },
        {
          "name": "string.quoted.single.vamp",
          "match": "'[^'\\\\\\n]'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vamp",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vamp",
          "match": "<<=|>>=|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|&&|\\|\\||<<|>>|[+*/=<>!%&|^~-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.vamp",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.vamp",
          "match": "[:,;]"
        },
        {
          "name": "punctuation.accessor.vamp",
          "match": "\\."
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.vamp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "line-comments": {
      "name": "comment.line.double-slash.vamp",
      "match": "//.*$"
    },
    "block-comments": {
      "name": "comment.block.vamp",
      "begin": "/\\*",
      "end": "\\*/"
    }
  }
}
