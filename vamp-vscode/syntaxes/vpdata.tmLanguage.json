{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vamp Data",
  "scopeName": "source.vampdata",
  "patterns": [
    {
      "include": "#line-comments"
    },
    {
      "include": "#block-comments"
    },
    {
      "name": "meta.object.vampdata",
      "match": "\\b(object)\\s+(\\\"[^\\\"]*\\\")",
      "captures": {
        "1": {
          "name": "keyword.control.vamp"
        },
        "2": {
          "name": "entity.name.type.class.vamp"
        }
      }
    },
    {
      "match": "\\b(path|type)\\s*(:)",
      "captures": {
        "1": {
          "name": "support.type.property-name.vamp"
        },
        "2": {
          "name": "punctuation.separator.vamp"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "captures": {
        "1": {
          "name": "variable.other.property.vamp"
        },
        "2": {
          "name": "punctuation.separator.vamp"
        }
      }
    },
    {
      "include": "#strings"
    },
    {
      "name": "constant.language.boolean.vamp",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.numeric.vamp",
      "match": "-?\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b"
    },
    {
      "name": "punctuation.section.group.vamp",
      "match": "[()\\[\\]]"
    },
    {
      "name": "punctuation.separator.vamp",
      "match": ","
    },
    {
      "include": "source.vamp"
    }
  ],
  "repository": {
    "line-comments": {
      "name": "comment.line.double-slash.vamp",
      "match": "//.*$"
    },
    "block-comments": {
      "name": "comment.block.vamp",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "strings": {
      "name": "string.quoted.double.vamp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vamp",
          "match": "\\\\[nrt0\\\"\\\\]"
        }
      ]
    }
  }
}
