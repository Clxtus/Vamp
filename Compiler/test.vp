import os

val window = os.Make_Window("Search")

val search = os.Make_Interface("frame", "Search", "test", (
    size = (300, 100),
    position = (20, 20),
    background_color = "#0e9e86",
    background_transparency = 1,
    visible = true,
    layer = 1
))

val label = os.Make_Interface("label", "Search", "label", (
    size = (42, 15),
    position = (10, 20),
    background_color = "#8b0000",
    background_transparency = 1,
    visible = true,
    text = "NIGGA",
    text_color = "#000000",
    layer = 4
))

val icon = os.Make_Interface("icon", "Search", "icon", (
    size = (100, 100),
    position = (100, 100),
    background_transparency = 0.0,
    visible = true,
    layer = 3,
    icon = "Icons/Data.ico"
))